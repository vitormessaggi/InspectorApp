<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checklist concluído"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#111111"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registro #CK-0611-042"
                android:textColor="#888888"
                android:layout_marginBottom="24dp"/>

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:layout_marginBottom="16dp"
                app:tint="#004D40" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inspeção enviada.\nNão opere a máquina."
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="O registro foi salvo e Marina Costa recebeu o alerta para avaliar a PH-07."
                android:textSize="16sp"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginBottom="32dp"/>

            <!-- Card Máquina Inoperante -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFEBEE"
                app:cardElevation="0dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Máquina inoperante"
                        android:textColor="#C62828"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PH-07"
                        android:textStyle="bold"
                        android:textColor="#111111"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prensa hidráulica"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#111111"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estamparia - Linha 02"
                        android:textColor="#555555"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aguardando decisão do supervisor"
                        android:textColor="#C62828"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card Resumo -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumo da inspeção"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginBottom="16dp"/>

                    <TextView android:text="Resultado: 2 conformes • 1 não conforme" android:layout_marginBottom="8dp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Falha crítica: Botão de emergência" android:textStyle="bold" android:layout_marginBottom="16dp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="16dp"/>

                    <TextView android:text="Enviado por: Rafael Lima • Matrícula 1042" android:layout_marginBottom="8dp" android:textColor="#555555" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Data e hora: 06 nov 2026 - 06:12" android:textColor="#555555" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Alerta Amarelo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF9C4"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mantenha a área sinalizada"
                    android:textStyle="bold"
                    android:textColor="#F57F17"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A máquina continua inoperante até que o supervisor registre a liberação."
                    android:textColor="#F57F17"/>
            </LinearLayout>

            <!-- Botões -->
            <Button
                android:id="@+id/btnVerRegistro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Ver registro completo"
                android:backgroundTint="#FFFFFF"
                android:textColor="#004D40"
                style="?android:attr/borderlessButtonStyle"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnVoltarChecklists"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="← Voltar aos checklists"
                android:textSize="16sp"
                android:backgroundTint="#004D40"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
