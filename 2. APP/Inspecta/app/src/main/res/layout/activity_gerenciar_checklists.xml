<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raizChecklist"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:background="#FFFFFF"
        android:elevation="4dp">
        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/checklist_voltar"
            android:src="@android:drawable/ic_menu_revert" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checklists"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formulários por máquina"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Defina os itens e sua criticidade. Os publicados ficam disponíveis para a equipe."
            android:textColor="#555555"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar formulário"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etBuscaFormulario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_search"
            android:hint="@string/checklist_busca_hint"
            android:inputType="text"
            android:textColor="#111111"
            android:textColorHint="#666666"
            android:drawableEnd="@android:drawable/ic_menu_search"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp" />

        <!-- Tabs Simples -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_search"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnPublicados"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@string/checklist_publicados"
                android:backgroundTint="#004D40"
                android:textColor="#FFFFFF"
                style="?android:attr/borderlessButtonStyle"/>

            <Button
                android:id="@+id/btnRascunhos"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@string/checklist_rascunhos"
                android:backgroundTint="@android:color/transparent"
                android:textColor="#888888"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvEstadoChecklists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:text="@string/checklist_carregando"
            android:textColor="#555555" />

        <!-- Lista de Formulários (RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFormularios"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />
    </LinearLayout>

    <!-- Botão Flutuante (ou fixo no rodapé) para Criar Checklist -->
    <Button
        android:id="@+id/btnNovoChecklist"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="+ Criar checklist"
        android:textSize="16sp"
        android:backgroundTint="#004D40"
        android:textColor="#FFFFFF" />
</LinearLayout>
