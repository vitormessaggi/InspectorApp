<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:padding="24dp">

    <!-- Cabeçalho -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SEXTA, 06 NOV 2026 • TURNO A"
        android:textSize="12sp"
        android:textColor="#666666"
        android:textAllCaps="true"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bom dia, Marina."
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Uma máquina precisa da sua avaliação antes de voltar à operação."
        android:textSize="16sp"
        android:textColor="#444444"
        android:layout_marginBottom="32dp" />

    <!-- Cards de Métricas em Linha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="32dp">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="100dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical">
                <TextView android:text="2/3" android:textSize="28sp" android:textStyle="bold" android:textColor="#004D40" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Inspeções feitas" android:textSize="12sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="100dp"
            android:layout_marginHorizontal="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical">
                <TextView android:text="1" android:textSize="28sp" android:textStyle="bold" android:textColor="#C62828" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Inoperante" android:textSize="12sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="100dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical">
                <TextView android:text="3" android:textSize="28sp" android:textStyle="bold" android:textColor="#111111" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Formulários" android:textSize="12sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Seção Precisa de Atenção (Alerta) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Precisa de atenção" android:textStyle="bold" android:textColor="#111111" android:textSize="18sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 alerta" android:textColor="#00796B" android:textStyle="bold" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="2dp"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inoperante" android:textColor="#C62828" android:textStyle="bold" android:background="#FFEBEE" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:layout_alignParentStart="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hoje, 06:12" android:textColor="#888888" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
            </RelativeLayout>

            <TextView android:text="PH-07" android:textStyle="bold" android:textColor="#111111" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Prensa hidráulica" android:textStyle="bold" android:textSize="18sp" android:textColor="#111111" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Estamparia - Linha 02" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp"/>

            <TextView android:text="Falha crítica no botão de emergência" android:textColor="#C62828" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Registrado por Rafael Lima • #CK-0611-042" android:textColor="#888888" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnRevisarMaquina"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="→ Revisar máquina"
                android:backgroundTint="#004D40"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Seção Gestão -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gestão de checklists" android:textStyle="bold" android:textColor="#111111" android:textSize="18sp" android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnGerenciarFormularios"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Gerenciar formulários"
        android:backgroundTint="#FFFFFF"
        android:textColor="#111111"
        style="?android:attr/borderlessButtonStyle"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCriarChecklist"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="+ Criar checklist"
        android:backgroundTint="#FFFFFF"
        android:textColor="#00796B"
        style="?android:attr/borderlessButtonStyle" />

</LinearLayout>