<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raizChecklist"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Cabeçalho -->
    <TextView
        android:id="@+id/tvDataTurno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#666666"
        android:textAllCaps="true"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSaudacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/saudacao"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvEstadoTurno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/inspecao_carregando_alertas"
        android:accessibilityLiveRegion="polite"
        android:textSize="16sp"
        android:textColor="#444444"
        android:layout_marginBottom="32dp" />

    <!-- Cards de Métricas em Linha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="32dp">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="100dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical">
                <TextView android:id="@+id/tvTotalInspecoes" android:text="@string/checklist_total_indisponivel" android:textSize="28sp" android:textStyle="bold" android:textColor="#004D40" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/inspecao_total_hoje" android:textSize="12sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="100dp"
            android:layout_marginHorizontal="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical">
                <TextView android:id="@+id/tvTotalInoperantes" android:text="@string/checklist_total_indisponivel" android:textSize="28sp" android:textStyle="bold" android:textColor="#C62828" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/inspecao_total_inoperantes" android:textSize="12sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="100dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical">
                <TextView android:id="@+id/tvTotalFormularios" android:text="@string/checklist_total_indisponivel" android:textSize="28sp" android:textStyle="bold" android:textColor="#111111" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Formulários" android:textSize="12sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Seção Precisa de Atenção (Alerta) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Precisa de atenção" android:textStyle="bold" android:textColor="#111111" android:textSize="18sp" />
        <TextView android:id="@+id/tvTotalAlertas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#00796B" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/listaAlertasCriticos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp" />

    <!-- Seção Gestão -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gestão de checklists" android:textStyle="bold" android:textColor="#111111" android:textSize="18sp" android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnGerenciarFormularios"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Gerenciar formulários"
        android:backgroundTint="#FFFFFF"
        android:textColor="#111111"
        style="?android:attr/borderlessButtonStyle"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCriarChecklist"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="+ Criar checklist"
        android:backgroundTint="#FFFFFF"
        android:textColor="#00796B"
        style="?android:attr/borderlessButtonStyle" />

</LinearLayout>
</ScrollView>
