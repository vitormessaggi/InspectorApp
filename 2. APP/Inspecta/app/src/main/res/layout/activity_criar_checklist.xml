<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:background="#FFFFFF"
        android:elevation="4dp">
        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_revert" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Criar checklist"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rascunho"
            android:background="#EEEEEE"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textSize="12sp"
            android:textColor="#555555" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do checklist"
                android:textColor="#555555"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etNomeChecklist"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_search"
                android:text="Segurança pré-turno"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Máquina"
                android:textColor="#555555"
                android:layout_marginBottom="8dp"/>
            <!-- Simulação de um Spinner/Dropdown -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search"
                android:text="PH-07 - Prensa hidráulica\nEstamparia - Linha 02"
                android:padding="16dp"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:layout_marginBottom="32dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Defina o risco de cada item"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#111111"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crítico: uma falha impede a operação. Não crítico: uma falha exige registro, mas não bloqueia sozinha."
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="24dp" />

            <!-- Aqui entraria uma RecyclerView para os itens dinâmicos do checklist.
                 Vou colocar o botão de adicionar diretamente. -->

            <Button
                android:id="@+id/btnAdicionarItem"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="+ Adicionar item"
                android:textColor="#004D40"
                android:backgroundTint="#E0F2F1"
                style="?android:attr/borderlessButtonStyle"
                android:layout_marginBottom="48dp"/>

            <Button
                android:id="@+id/btnPublicarChecklist"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="✓ Publicar checklist"
                android:textSize="16sp"
                android:backgroundTint="#004D40"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSalvarRascunho"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Salvar como rascunho"
                android:backgroundTint="@android:color/transparent"
                android:textColor="#004D40"
                style="?android:attr/borderlessButtonStyle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Após publicar, o checklist ficará disponível para os funcionários desta máquina."
                android:textAlignment="center"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>