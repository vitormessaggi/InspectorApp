rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {
function perfilInspecta() {
  let atual = /databases/$(database)/documents/usuarios/$(request.auth.uid);
  return exists(atual) ? get(atual).data
    : get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
}
function papelInspecta() {
  let perfil = perfilInspecta();
  return perfil.get('perfil', perfil.get('tag', ''));
}
function supervisorInspecta() {
  return request.auth != null && papelInspecta().matches('(?i)^\\s*supervisor\\s*$');
}
function operadorInspecta() {
  return request.auth != null && papelInspecta().matches('(?i)^\\s*operador\\s*$');
}

match /usuarios/{uid} {
  allow get: if request.auth != null && request.auth.uid == uid;
  allow create: if request.auth != null && request.auth.uid == uid
    && !exists(/databases/$(database)/documents/users/$(uid))
    && request.resource.data.keys().hasOnly(['nome', 'perfil'])
    && request.resource.data.nome is string && request.resource.data.nome.trim().size() > 0
    && request.resource.data.perfil == 'Pendente';
}
match /users/{uid} {
  allow get: if request.auth != null && request.auth.uid == uid;
}
match /maquinas/{maquinaId} {
  allow read: if supervisorInspecta() || operadorInspecta();
  allow create: if supervisorInspecta()
    && request.resource.data.keys().hasOnly(['codigo', 'nome', 'setor', 'tipo', 'checklistId'])
    && request.resource.data.codigo is string
    && request.resource.data.codigo.size() > 0 && request.resource.data.codigo.size() <= 80
    && request.resource.data.nome is string && request.resource.data.nome.trim().size() > 0
    && request.resource.data.setor is string && request.resource.data.setor.trim().size() > 0
    && request.resource.data.tipo is string && request.resource.data.tipo.trim().size() > 0
    && bloqueioInspecta(request.resource.data.codigo)
      == /databases/$(database)/documents/bloqueiosMaquinas/$(maquinaId)
    && get(/databases/$(database)/documents/checklists/$(request.resource.data.checklistId)).data.publicado == true;
}

function bloqueioInspecta(codigo) {
  let id = 'maq-' + codigo.trim().upper().replace('%', '%25').replace('/', '%2F');
  return /databases/$(database)/documents/bloqueiosMaquinas/$(id);
}

match /checklists/{checklistId} {
  function checklistValido() {
    let dados = request.resource.data;
    return dados.keys().hasOnly([
        'nome', 'tipo', 'codigoMaquina', 'nomeMaquina', 'setor', 'itens', 'indicesItens',
        'publicado', 'criadoPor', 'atualizadoEm', 'indicesCriticos', 'versaoAnteriorId'
      ])
      && dados.nome is string && dados.nome.size() > 0
      && dados.codigoMaquina is string && dados.nomeMaquina is string
      && dados.setor is string && dados.itens is list && dados.publicado is bool
      && dados.get('indicesCriticos', []) is list
      && dados.criadoPor is string && dados.atualizadoEm == request.time
      && dados.get('tipo', '') is string
      && (!dados.publicado || (dados.itens.size() > 0 && dados.tipo.trim().size() > 0));
  }

  function versaoArquivada(id) {
    let caminho = /databases/$(database)/documents/checklists/$(checklistId)/versoes/$(id);
    return !exists(caminho) && getAfter(caminho).data == resource.data;
  }

  function edicaoValida() {
    let dados = request.resource.data;
    return checklistValido() && dados.criadoPor == resource.data.criadoPor
      && (resource.data.publicado == false
        ? !dados.keys().hasAny(['versaoAnteriorId'])
        : dados.publicado == true && dados.codigoMaquina == resource.data.codigoMaquina
          && dados.versaoAnteriorId is string && versaoArquivada(dados.versaoAnteriorId));
  }

  function exclusaoValida() {
    let dados = request.resource.data;
    return dados.diff(resource.data).affectedKeys().hasOnly(['publicado', 'excluidoEm', 'excluidoPor'])
      && dados.publicado == false && dados.excluidoEm == request.time
      && dados.excluidoPor == request.auth.uid;
  }

  allow read: if supervisorInspecta() || (operadorInspecta() && resource.data.publicado == true);

  allow create: if supervisorInspecta() && checklistValido()
    && !request.resource.data.keys().hasAny(['versaoAnteriorId'])
    && request.resource.data.criadoPor == request.auth.uid;

  allow update: if supervisorInspecta() && !resource.data.keys().hasAny(['excluidoEm'])
    && (exclusaoValida() || edicaoValida());

  match /versoes/{versaoId} {
    function copiaDaVersaoAnterior() {
      let caminho = /databases/$(database)/documents/checklists/$(checklistId);
      let anterior = get(caminho).data;
      let atual = getAfter(caminho).data;
      return anterior.publicado == true && request.resource.data == anterior
        && atual.versaoAnteriorId == versaoId && atual.atualizadoEm == request.time;
    }

    allow read: if supervisorInspecta();
    allow create: if supervisorInspecta() && copiaDaVersaoAnterior();
  }
}

match /inspecoes/{inspecaoId} {
  function checklistEnviado(dados) {
    return get(/databases/$(database)/documents/checklists/$(dados.checklistId)).data;
  }

  function falhasConferem(dados, checklist) {
    let falhas = dados.falhas.toSet();
    let criticas = dados.falhasCriticas.toSet();
    let indicesCriticos = checklist.get('indicesCriticos', null);
    return dados.falhas.size() == falhas.size() && falhas.size() <= checklist.itens.size()
      && dados.falhasCriticas.size() == criticas.size() && falhas.hasAll(criticas)
      && (indicesCriticos == null || falhas.intersection(indicesCriticos.toSet()) == criticas)
      && dados.pendente == (criticas.size() > 0)
      && dados.perguntasCriticas.size() == criticas.size()
      && (!dados.pendente || (checklist.itens[dados.falhasCriticas[0]].critico == true
        && dados.perguntasCriticas[0] == checklist.itens[dados.falhasCriticas[0]].pergunta));
  }

  function bloqueioConfere(dados) {
    let caminho = bloqueioInspecta(dados.codigoMaquina);
    return !exists(caminho) && (dados.pendente
      ? getAfter(caminho).data.inspecaoId == inspecaoId
      : !existsAfter(caminho));
  }

  function maquinaConfere(dados, checklist) {
    let caminho = /databases/$(database)/documents/maquinas/$('maq-' + dados.codigoMaquina.trim().upper().replace('%', '%25').replace('/', '%2F'));
    let maquina = exists(caminho) ? get(caminho).data : {
      'checklistId': dados.checklistId, 'codigo': checklist.codigoMaquina,
      'nome': checklist.nomeMaquina, 'setor': checklist.setor
    };
    return dados.codigoMaquina.size() > 0 && maquina.checklistId == dados.checklistId
      && dados.codigoMaquina == maquina.codigo && dados.nomeMaquina == maquina.nome && dados.setor == maquina.setor;
  }

  function inspecaoValida(dados) {
    let checklist = checklistEnviado(dados);
    let nome = perfilInspecta().get('nome', '');
    return dados.keys().hasOnly([
        'checklistId', 'checklistAtualizadoEm', 'checklistNome', 'codigoMaquina', 'nomeMaquina', 'setor',
        'operadorUid', 'operadorNome', 'observacao', 'falhas', 'falhasCriticas',
        'perguntasCriticas', 'pendente', 'enviadaEm', 'respostas', 'itens'
      ])
      && checklist.publicado == true
      && dados.get('checklistAtualizadoEm', checklist.get('atualizadoEm', null)) == checklist.get('atualizadoEm', null)
      && dados.checklistNome == checklist.nome && maquinaConfere(dados, checklist)
      && dados.operadorUid == request.auth.uid && dados.operadorNome == (nome is string ? nome : '')
      && dados.observacao is string && dados.observacao.size() <= 2000
      && (dados.falhas.size() == 0 || dados.observacao.trim().size() > 0)
      && dados.itens == checklist.itens
      && dados.respostas is list && dados.respostas.size() == checklist.itens.size()
      && dados.respostas.hasOnly([1, 2])
      && dados.respostas.removeAll([1]).size() == dados.falhas.size()
      && (checklist.get('indicesItens', null) == null || checklist.indicesItens.hasAll(dados.falhas))
      && dados.falhas is list && dados.falhasCriticas is list && dados.perguntasCriticas is list
      && dados.enviadaEm == request.time
      && falhasConferem(dados, checklist) && bloqueioConfere(dados);
  }

  function liberacaoValida(dados) {
    let caminho = bloqueioInspecta(resource.data.codigoMaquina);
    return resource.data.pendente == true && dados.pendente == false
      && dados.diff(resource.data).affectedKeys().hasOnly([
        'pendente', 'liberadoPor', 'liberadaEm', 'justificativaLiberacao',
        'correcaoVerificada', 'segurancaVerificada'
      ])
      && dados.liberadoPor == request.auth.uid && dados.liberadaEm == request.time
      && dados.correcaoVerificada == true && dados.segurancaVerificada == true
      && dados.justificativaLiberacao is string && dados.justificativaLiberacao.trim().size() > 0
      && dados.justificativaLiberacao.size() <= 2000
      && get(caminho).data.inspecaoId == inspecaoId && !existsAfter(caminho);
  }

  allow get: if supervisorInspecta()
    || (operadorInspecta() && (resource == null || resource.data.operadorUid == request.auth.uid));
  allow list: if supervisorInspecta() || (operadorInspecta() && resource.data.operadorUid == request.auth.uid);
  allow create: if operadorInspecta() && inspecaoValida(request.resource.data);
  allow update: if supervisorInspecta() && liberacaoValida(request.resource.data);
}

match /bloqueiosMaquinas/{maquinaId} {
  function caminhoInspecao(id) {
    return /databases/$(database)/documents/inspecoes/$(id);
  }

  function aberturaValida(caminho) {
    let registro = getAfter(caminho).data;
    return !exists(caminho) && registro.pendente == true && registro.enviadaEm == request.time
      && registro.operadorUid == request.auth.uid
      && bloqueioInspecta(registro.codigoMaquina)
        == /databases/$(database)/documents/bloqueiosMaquinas/$(maquinaId);
  }

  function encerramentoValido(caminho) {
    let registro = getAfter(caminho).data;
    return get(caminho).data.pendente == true && registro.pendente == false
      && registro.liberadaEm == request.time && registro.liberadoPor == request.auth.uid;
  }

  allow read: if supervisorInspecta() || operadorInspecta();
  allow create: if operadorInspecta() && request.resource.data.keys().hasOnly(['inspecaoId'])
    && aberturaValida(caminhoInspecao(request.resource.data.inspecaoId));
  allow delete: if supervisorInspecta() && encerramentoValido(caminhoInspecao(resource.data.inspecaoId));
}

}
}
